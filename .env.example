# MongoDB
DATABASE_URL=mongodb://127.0.0.1:27017/oddsclub
# Long random string (e.g. `openssl rand -hex 32`)
PAYLOAD_SECRET=change-me
# Public URL of the site (no trailing slash), e.g. https://oddsclub.example
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Backblaze B2 (S3-compatible) — leave empty in development to store uploads on disk.
# Create an application key in B2 → App Keys. Endpoint is shown on the bucket page ("S3 Endpoint").
B2_BUCKET=
B2_KEY_ID=
B2_APP_KEY=
B2_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
B2_REGION=eu-central-003
