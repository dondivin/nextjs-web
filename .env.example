# MongoDB
DATABASE_URL=mongodb://127.0.0.1:27017/oddsclub
# Long random string (e.g. `openssl rand -hex 32`)
PAYLOAD_SECRET=change-me
# Public URL of the site (no trailing slash), e.g. https://oddsclub.example
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Cloudflare R2 (uploads: chat avatars, partner logos…) — leave empty in development to store uploads on disk (./media).
# Cloudflare dashboard → R2 → create a bucket → "Manage R2 API Tokens" → token with Object Read & Write on that bucket.
# R2_ACCOUNT_ID is shown on the R2 overview page.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional: public domain of the bucket (bucket → Settings → Custom domain, e.g. https://media.oddsclub.example).
# Set it to serve images straight from Cloudflare's CDN; leave empty to serve them through the site.
R2_PUBLIC_URL=

# Encrypts message texts at rest: 32 random bytes, base64 (node -e "console.log(require('crypto').randomBytes(32).toString('base64'))").
# Keep a backup — losing it makes stored message texts unreadable. While changing it: CHAT_MASTER_KEY_OLD = the previous one.
CHAT_MASTER_KEY=

# Optional: where pnpm data:export / pnpm seed keep the database snapshot (default seed-data/snapshot). See docs/MOVING-DATA.md.
# OC_SNAPSHOT_DIR=seed-data/snapshot
